     "n"
    ],
    [
     "install stable updates",
     "yes"
    ],
    [
     "Do you want to continue",
     "y"
    ],
    [
     "Remove ALL superuser",
     "n"
    ],
    [
     "Lock the root account",
     "y"
    ],
    [
     "Linux Mint: turn on Update Manager",
     "y"
    ]
   ]
  },
  {
