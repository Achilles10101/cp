    "SUDO_USER": "cpuser",
    "DEBIAN_FRONTEND": "readline",
    "SSH_PORT": "22",
    "FINDINGS": "0"
   },
   "env": {},
   "rules": [
    [
     "\\[SERVICE\\] (apache2|FTP servers|PHP):.*Remove\\?",
     "y"
    ],
    [
     "\\[SERVICE\\].*Remove\\?",
     "n"
    ],
    [
     "\\[REVIEW\\].*Remove\\?",
     "n"
    ],
    [
     "Remove\\? \\[",
     "y"
    ],
    [
     "Purge these",
     "y"
    ],
    [
     "Run autoremove",
     "y"
    ],
    [
     "Purge their config",
     "y"
    ],
    [
     "dpkg --purge",
     "y"
    ]
   ]
  },
  {
