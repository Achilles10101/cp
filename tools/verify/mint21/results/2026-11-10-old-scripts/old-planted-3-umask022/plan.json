     "y"
    ],
    [
     "Delete account toor",
     "y"
    ],
    [
     "Open /etc/sudoers.* in visudo",
     "y"
    ],
    [
     "Set a password for carol",
     "y"
    ],
    [
     "New password:",
     "Car0l-Str0ng!pw"
    ],
    [
     "Retype new password:",
     "Car0l-Str0ng!pw"
    ]
   ]
  },
