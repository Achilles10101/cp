    "IDLE": "2.5",
    "HARD": "1500",
    "UMASK": "0022",
    "SUDO_USER": "cpuser",
    "DEBIAN_FRONTEND": "readline",
    "SSH_PORT": "22",
    "FINDINGS": "0"
   },
